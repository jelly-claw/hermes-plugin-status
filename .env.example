# Status settings for the Hermes Status plugin. Append these to ~/.hermes/.env
# (bin/status-create-account --write-env ~/.hermes/.env fills the first five).

# Required — the bot's Status account on the local status-backend
STATUS_KEY_UID=0x...
STATUS_PASSWORD=change-me
STATUS_DATA_DIR=/home/YOU/.status-backend/data

# Optional
STATUS_PORT=21405
STATUS_PROFILE_NAME=Jelly          # display name kept on the bot's Status profile
ASSISTANT_NAME=Jelly               # bot name; also the typed "@Jelly" wake word in groups

# Who may talk to the bot: YOUR Status chat key(s) (0x04…), space/comma separated.
# DMs are accepted only from these keys; groups only when one of them is a member.
STATUS_ALLOW_FROM=0x04...
# Where cron jobs / send_message deliver by default (usually your 1:1 chat key).
STATUS_HOME_CHANNEL=0x04...
# Let every member of an admitted group address the group's agent (not just you).
# WARNING: those members then reach the agent's full toolset.
STATUS_ALLOW_ALL_USERS=true
