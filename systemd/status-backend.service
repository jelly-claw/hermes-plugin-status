# status-backend — status-go's HTTP/RPC server (Status / Waku bridge for Hermes).
# Installed by setup.sh: @USER@, @HOME@, @PORT@ and @LIBDIR@ are substituted.
# Build status-backend + libsds yourself from https://github.com/status-im/status-go
# (see README, "Build status-backend").
[Unit]
Description=Status Backend (Waku)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Environment=HOME=@HOME@
Environment=LD_LIBRARY_PATH=@LIBDIR@
ExecStart=/usr/local/bin/status-backend --address 127.0.0.1:@PORT@
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
