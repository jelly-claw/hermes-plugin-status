#!/usr/bin/env bash
# restart-hermes — all-in-one graceful (re)start of the Hermes gateway stack.
#
# Stack:
#   status-backend           Status / Waku bridge, Docker container (port 21405)
#   hermes-gateway.service   Hermes messaging gateway (depends on status-backend)
#
# Default behaviour:
#   1. Ensure status-backend is running + healthy (restart only if unhealthy).
#   2. Gracefully restart the Hermes gateway (SIGTERM → drain, up to 210s).
#   3. Report final service states.
#
# Flags:
#   --full         Also force-restart status-backend (fresh Waku login).
#   --backend-only Restart/heal status-backend only; leave the gateway alone.
#   -h, --help     Show this help.
#
# The gateway restart is graceful: systemd sends SIGTERM and the unit's
# TimeoutStopSec lets in-flight agent turns drain before exit.
set -euo pipefail

STATUS_PORT="${STATUS_PORT:-21405}"
HEALTH_URL="http://127.0.0.1:${STATUS_PORT}/health"
BACKEND_CTR="${STATUS_BACKEND_CONTAINER:-status-backend}"
GATEWAY_SVC="hermes-gateway.service"

FULL=0
BACKEND_ONLY=0
for arg in "$@"; do
  case "$arg" in
    --full)         FULL=1 ;;
    --backend-only) BACKEND_ONLY=1 ;;
    -h|--help)      sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unknown option: $arg (try --help)" >&2; exit 2 ;;
  esac
done

cyan() { printf '\033[36m▸ %s\033[0m\n' "$*"; }
green() { printf '\033[32m✓ %s\033[0m\n' "$*"; }
red() { printf '\033[31m✗ %s\033[0m\n' "$*"; }

backend_healthy() { curl -sf "$HEALTH_URL" >/dev/null 2>&1; }

wait_for_backend() {
  cyan "Waiting for status-backend health…"
  for i in $(seq 1 30); do
    if backend_healthy; then green "status-backend healthy"; return 0; fi
    sleep 2
  done
  red "status-backend not healthy after 60s"; return 1
}

# ── 1. status-backend ──────────────────────────────────────────────────────
if [[ "$FULL" -eq 1 ]]; then
  cyan "Force-restarting status-backend…"
  docker restart "$BACKEND_CTR" >/dev/null
  wait_for_backend
elif backend_healthy; then
  green "status-backend already healthy — leaving it running"
else
  cyan "status-backend unhealthy — (re)starting…"
  docker restart "$BACKEND_CTR" >/dev/null
  wait_for_backend
fi

# ── 2. Hermes gateway (graceful) ────────────────────────────────────────────
if [[ "$BACKEND_ONLY" -eq 0 ]]; then
  cyan "Gracefully restarting Hermes gateway…"
  sudo systemctl restart "$GATEWAY_SVC"
  green "gateway restart issued"
fi

# ── 3. Report ───────────────────────────────────────────────────────────────
echo
cyan "Service states:"
printf '  %-24s %s\n' "$BACKEND_CTR (docker)" \
  "$(docker inspect -f 'status={{.State.Status}} restart={{.HostConfig.RestartPolicy.Name}}' "$BACKEND_CTR" 2>/dev/null || echo 'not found')"
for svc in "$GATEWAY_SVC"; do
  active="$(systemctl is-active "$svc" 2>/dev/null || true)"
  enabled="$(systemctl is-enabled "$svc" 2>/dev/null || true)"
  printf '  %-24s active=%-8s enabled=%s\n' "$svc" "$active" "$enabled"
done
echo
echo "Logs:  journalctl -u hermes-gateway -f"
